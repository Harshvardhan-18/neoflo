# Visual AI Agent — Backend Environment Configuration

# PostgreSQL (Docker Compose runs on port 5433)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/visual_ai_agent
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5433/visual_ai_agent

# ─── Vision AI ──────────────────────────────────────────────────────────────
# GitHub Personal Access Token (classic or fine-grained) for GitHub Models.
# Required scopes: none (GitHub Models is available to all authenticated users).
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-pat-here

# GitHub Models inference endpoint (do not change unless self-hosting)
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com

# Vision model served via GitHub Models marketplace
VISION_MODEL=gpt-4o-mini

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:5173,http://localhost:3000
